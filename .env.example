# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# Required: Groq API key (starts with gsk_), from https://console.groq.com
GROQ_API_KEY=

# Storage: "supabase" (production) or "sqlite" (local only).
# Defaults to supabase when SUPABASE_URL is set, otherwise sqlite.
STORAGE_BACKEND=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=meal-thumbnails

# Only used when STORAGE_BACKEND=sqlite
# DATABASE_PATH=data/nutrilens.db

# Accounts and sessions
SESSION_DAYS=14
# Set to true when the app is served over HTTPS (production)
COOKIE_SECURE=false

# Optional overrides
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# MAX_UPLOAD_MB=10
